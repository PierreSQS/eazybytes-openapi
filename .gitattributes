# Enforce LF endings for all text files
* text=auto eol=lf

# Specifically enforce LF for common config and source files
*.sh text eol=lf
*.properties text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files - do not change line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.zip binary
*.exe binary
